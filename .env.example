# ============================================================
# One Day Wear — Environment Variables Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file containing real credentials to Git.

# ------------------------------------------------------------
# Database (MySQL) Configuration
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# ------------------------------------------------------------
# Service Discovery (Eureka) Configuration
# ------------------------------------------------------------
EUREKA_HOST=localhost
EUREKA_PORT=8761
EUREKA_URL=http://localhost:8761/eureka/

# ------------------------------------------------------------
# API Gateway Configuration
# ------------------------------------------------------------
GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------
# Security / JWT Configuration
# ------------------------------------------------------------
# Note: Key must be at least 256 bits (32 bytes) for HMAC-SHA256
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRATION=86400000

# ------------------------------------------------------------
# Payment Gateway (Razorpay) Configuration
# ------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ------------------------------------------------------------
# Mail / SMTP (Gmail) Configuration
# ------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# ------------------------------------------------------------
# Image Upload / File Storage Configuration
# ------------------------------------------------------------
# Local path: ./uploads | Docker container path: /app/uploads
FILE_UPLOAD_DIR=./uploads
APP_BASE_URL=http://localhost:8080

# ------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
